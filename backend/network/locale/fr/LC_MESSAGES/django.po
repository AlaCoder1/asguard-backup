#: backend/network/validation.py:12
msgid "Invalid IP address format"
msgstr "Format d'adresse IP non valide"

#: backend/network/validation.py:20
msgid "Invalid network mask format"
msgstr "Format de masque réseau non valide"

#: backend/network/validation.py:26
msgid "Invalid MAC address format"
msgstr "Format d'adresse MAC non valide"

#: backend/network/validation.py:34
msgid "Invalid speed/duplex configuration"
msgstr "Configuration de vitesse/duplex non valide"

#: backend/network/validation.py:42
msgid "Invalid setup ipv4 configuration"
msgstr "Configuration IPv4 non valide"

#: backend/network/validation.py:49
msgid "Invalid aux"
msgstr "AUX invalide"

#: backend/network/validation.py:77
msgid "Interface does not exist!"
msgstr "L'interface n'existe pas !"

#: backend/network/validation.py:85
msgid ""
"Invalid MAC address format. Expected format: XX:XX:XX:XX:XX:XX or XX-XX-XX-"
"XX-XX-XX."
msgstr ""
"Format d'adresse MAC non valide comme celui-ci XX:XX:XX:XX:XX:XX ou XX-XX-XX-"
"XX-XX-XX"

#: backend/network/validation.py:88
msgid "Invalid MAC address: cannot use all zeros (00:00:00:00:00:00)."
msgstr ""
"Adresse MAC non valide : impossible d'utiliser uniquement des zéros "
"(00:00:00:00:00:00)."

#: backend/network/validation.py:92
msgid ""
"Invalid MAC address: multicast addresses are not allowed; the address must "
"be unicast."
msgstr ""
"Adresse MAC non valide : seules les adresses unicast (monodiffusion) sont "
"autorisées."

#: backend/network/validation.py:100 backend/network/validation.py:110
msgid "Invalid IP address. Format like this x.x.x.x"
msgstr "Adresse IP non valide. Format comme ceci x.x.x.x"

#: backend/network/validation.py:108
msgid "Gateway address does not exist in the Gateway table"
msgstr "L'adresse de la passerelle n'existe pas dans la table des passerelles"

#: backend/network/validation.py:126
msgid "Invalid network mask: "
msgstr "Masque réseau non valide :"

#: backend/network/validation.py:136
msgid "Invalid speed/duplex configuration. Allowed values are: "
msgstr ""
"Configuration de vitesse/duplex non valide. Les valeurs autorisées sont :"

#: backend/network/validation.py:144
msgid "Invalid setup ipv4 configuration. Allowed values are: "
msgstr "Configuration IPv4 non valide. Les valeurs autorisées sont :"

#: backend/network/validation.py:151
msgid "Invalid dhcp ipv4 configuration. Allowed values are: "
msgstr "Configuration DHCP IPv4 non valide. Les valeurs autorisées sont : "

#: backend/network/validation.py:158
msgid "Invalid boolean value: "
msgstr "Valeur booléenne non valide : "

#: backend/network/validation.py:166
#, fuzzy
#| msgid "MTU value is outside the allowed range  "
msgid "MTU value is outside the allowed range "
msgstr "La valeur MTU est en dehors de la plage autorisée "

#: backend/network/validation.py:174
msgid "MSS value is too small. Minimum MSS  is 576 bytes."
msgstr ""
"La valeur MSS est trop petite. La valeur MSS minimale est de 576 octets."

#: backend/network/validation.py:183
msgid "Hostname exceeds the maximum length of 253 characters."
msgstr "Le nom d'hôte dépasse la longueur maximale de 253 caractères."

#: backend/network/validation.py:189
msgid ""
"Hostname  is invalid. It must contain only letters, digits, or hyphens, and "
"each label must start and end with a letter or digit."
msgstr ""
"Le nom d'hôte n'est pas valide. Il doit contenir uniquement des lettres, des "
"chiffres ou des tirets, et chaque libellé doit commencer et se terminer par "
"une lettre ou un chiffre."

#: backend/network/validation.py:197
msgid "Timeout must be a number (integer or float)."
msgstr "Le délai d'expiration doit être un nombre (entier ou flottant)."

#: backend/network/validation.py:200
msgid "Timeout value is out of range. It must be between 1 and 300 seconds."
msgstr ""
"La valeur du délai d'attente est hors limites. Elle doit être comprise entre "
"1 et 300 secondes"

