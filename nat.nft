table ip nat {
	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		oifname "enp0s3" ip saddr 10.1.12.0/24 ip daddr 69.63.184.142 tcp sport 80 tcp dport 443 ip protocol udp masquerade
		oifname "enp0s3" ip daddr 69.63.184.142 tcp dport 443 ip protocol udp masquerade
		oifname "enp0s3" ip protocol udp masquerade
		oifname "enp0s3" ip saddr 10.1.12.0/24 ip daddr 50.30.30.0/24 tcp sport 443 tcp dport 22 ip protocol udp masquerade
		oifname "enp0s3" ip saddr 10.1.12.0/24 snat to 51.32.200.0/24
		oifname "enp0s3" ip saddr 10.1.12.0/24 ip daddr 50.50.50.0/24 snat to 51.32.100.0/24
		oifname "enp0s3" ip protocol udp snat to 51.32.100.5-51.32.100.8:443
		oifname "enp0s3" ip saddr 10.1.12.0/24 snat to 51.32.100.0/24
	}

	chain prerouting {
		type nat hook prerouting priority 100; policy accept;
		iifname "enp0s3" ip daddr 51.20.20.0 tcp dport 80-443 ip protocol udp dnat to 10.1.12.0:5000
		iifname "enp0s3" ip saddr 50.50.50.50 ip daddr 51.10.10.0 tcp sport 80 ip protocol udp dnat to 10.1.12.175
		iifname "enp0s3" ip saddr 50.50.50.50 ip daddr 51.10.10.0 tcp sport 80 ip protocol udp dnat to 10.1.12.100
	}
}
